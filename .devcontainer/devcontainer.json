{
  "name": "数据中心配件流通系统",
  "dockerComposeFile": [
    "../docker-compose.yml",
    "../docker-compose.dev.yml"
  ],
  "service": "devcontainer",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:2": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-spring-boot",
        "Vue.volar",
        "dbaeumer.vscode-eslint",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "java.configuration.updateBuildConfiguration": "automatic",
        "java.compile.nullAnalysis.mode": "automatic"
      }
    }
  },
  "forwardPorts": [3000, 5432, 8080, 8081, 8082, 8848],
  "portsAttributes": {
    "3000": {
      "label": "Frontend (Vite Dev)",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "API Gateway",
      "onAutoForward": "silent"
    },
    "8081": {
      "label": "Server Service",
      "onAutoForward": "silent"
    },
    "8082": {
      "label": "Accessory Service",
      "onAutoForward": "silent"
    },
    "8848": {
      "label": "Nacos Console",
      "onAutoForward": "silent"
    },
    "5432": {
      "label": "PostgreSQL",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "mvn dependency:resolve -B -q && cd frontend && npm install",
  "remoteUser": "vscode"
}
