# syntax=docker/dockerfile:1
# 构建 PigX 平台模块（pig-auth / pig-upms-biz 等）
ARG SERVICE_MODULE=pig-auth
ARG SERVICE_PORT=3000
ARG JAR_NAME=pig-auth.jar

FROM maven:3.9-eclipse-temurin-17 AS builder
ARG SERVICE_MODULE
WORKDIR /build

COPY pig /build/pig
WORKDIR /build/pig
RUN mvn clean package -DskipTests -B -pl ${SERVICE_MODULE} -am

FROM eclipse-temurin:17-jre-alpine AS runtime
ARG SERVICE_MODULE
ARG SERVICE_PORT
ARG JAR_NAME
WORKDIR /app

RUN addgroup -S spring && adduser -S spring -G spring
USER spring:spring

COPY --from=builder /build/pig/${SERVICE_MODULE}/target/${JAR_NAME} app.jar

EXPOSE ${SERVICE_PORT}
ENTRYPOINT ["java", "-jar", "app.jar"]
