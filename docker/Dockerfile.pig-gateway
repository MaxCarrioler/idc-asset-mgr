# syntax=docker/dockerfile:1
FROM maven:3.9-eclipse-temurin-17 AS builder
WORKDIR /build

COPY pig/pom.xml pig/pom.xml
COPY pig/pig-common pig/pig-common
COPY pig/pig-gateway pig/pig-gateway
COPY pig/pig-upms/pig-upms-api pig/pig-upms/pig-upms-api
COPY pig/pig-upms/pom.xml pig/pig-upms/pom.xml
COPY IDC-Manager/pom.xml IDC-Manager/pom.xml
COPY IDC-Manager/config/gateway-local.yml IDC-Manager/config/gateway-local.yml

WORKDIR /build/pig/pig-gateway
RUN mvn clean package -DskipTests -B

FROM eclipse-temurin:17-jre-alpine AS runtime
WORKDIR /app
COPY --from=builder /build/pig/pig-gateway/target/pig-gateway.jar app.jar
COPY --from=builder /build/IDC-Manager/config/gateway-local.yml /app/config/gateway-local.yml

EXPOSE 9999
ENTRYPOINT ["java", "-jar", "app.jar", "--spring.config.additional-location=file:/app/config/gateway-local.yml"]
