# syntax=docker/dockerfile:1

ARG SERVICE_MODULE=dc-server-service
ARG SERVICE_PORT=8081

FROM maven:3.9-eclipse-temurin-17 AS builder
ARG SERVICE_MODULE
WORKDIR /build

COPY pom.xml .
COPY dc-common/pom.xml dc-common/
COPY dc-gateway/pom.xml dc-gateway/
COPY dc-server-service/pom.xml dc-server-service/
COPY dc-accessory-service/pom.xml dc-accessory-service/

RUN mvn dependency:go-offline -B -pl ${SERVICE_MODULE} -am

COPY dc-common dc-common
COPY ${SERVICE_MODULE} ${SERVICE_MODULE}

RUN mvn clean package -DskipTests -B -pl ${SERVICE_MODULE} -am

FROM eclipse-temurin:17-jre-alpine AS runtime
ARG SERVICE_MODULE
ARG SERVICE_PORT
WORKDIR /app

RUN addgroup -S spring && adduser -S spring -G spring
USER spring:spring

COPY --from=builder /build/${SERVICE_MODULE}/target/*.jar app.jar

EXPOSE ${SERVICE_PORT}

ENTRYPOINT ["java", "-jar", "app.jar"]
