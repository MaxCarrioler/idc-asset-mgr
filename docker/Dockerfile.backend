# syntax=docker/dockerfile:1
# 构建 IDC 单体后端（构建上下文为仓库父目录，与 ../pig 时代保持一致）

FROM maven:3.9-eclipse-temurin-17 AS builder
WORKDIR /build

COPY IDC-Manager/pom.xml IDC-Manager/pom.xml
COPY IDC-Manager/idc-app/pom.xml IDC-Manager/idc-app/pom.xml
RUN mvn -f IDC-Manager/pom.xml dependency:go-offline -B || true

COPY IDC-Manager/idc-app/src IDC-Manager/idc-app/src
RUN mvn -f IDC-Manager/pom.xml clean package -DskipTests -B

FROM eclipse-temurin:17-jre-alpine AS runtime
WORKDIR /app

RUN addgroup -S spring && adduser -S spring -G spring
USER spring:spring

COPY --from=builder /build/IDC-Manager/idc-app/target/idc-app.jar app.jar

EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
